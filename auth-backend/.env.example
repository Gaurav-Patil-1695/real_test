# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/auth_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# Bcrypt
BCRYPT_ROUNDS=12

# Password reset token
RESET_TOKEN_TTL_MINUTES=60

# Refresh token
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_REMEMBER_ME_DAYS=30

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Auth Starter
SMTP_TLS=true

# Rate limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=300

# Application
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
